{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ctx-ppteer status document",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": {
      "enum": [1, 2],
      "description": "Version 1 is read for compatibility. Successful writes use version 2."
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 2 } } },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "points": {
                  "items": { "required": ["id"] }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folder_name", "session_id", "branch", "points", "updated_at"],
      "properties": {
        "folder_name": {
          "$ref": "#/$defs/line"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "type": "null"
            }
          ],
          "description": "Real session ID. Null is supported only for reading legacy records; MCP writes require a non-empty string."
        },
        "branch": {
          "$ref": "#/$defs/line"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "done": {
          "type": "boolean",
          "default": false
        },
        "link": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https?://\\S+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 timestamp. Existing point IDs retain their timestamp when omitted on edit; a valid caller-supplied timestamp is preserved."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable server-assigned point identity."
        }
      }
    }
  }
}
