{
  "name": "ctx-ppteer",
  "version": "0.2.0",
  "description": "A lightweight agent status viewer",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests package.json status.schema.json README.md svelte.config.js vite.config.ts tsconfig.json playwright.config.ts .prettierrc",
    "format:check": "prettier --check src tests package.json status.schema.json README.md svelte.config.js vite.config.ts tsconfig.json playwright.config.ts .prettierrc",
    "test:controller": "node --experimental-strip-types --test tests/viewer-controller.test.ts",
    "test:lifecycle": "node --experimental-strip-types --test tests/settings-lifecycle.test.ts",
    "test:retention": "node --experimental-strip-types --test tests/settings-retention.test.ts",
    "test:motion": "playwright test tests/viewer-motion.spec.ts",
    "test": "npm run test:controller && npm run test:lifecycle && npm run test:retention && npm run check && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "svelte": "^5.0.0",
    "svelte-spa-router": "^5.1.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.10.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
