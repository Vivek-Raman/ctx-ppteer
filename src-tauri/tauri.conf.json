{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context Status",
  "version": "0.1.0",
  "identifier": "com.ctxppteer.status",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Context Status",
        "width": 360,
        "height": 220,
        "minWidth": 260,
        "minHeight": 120,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Always-on-top Markdown status viewer",
    "longDescription": "A lightweight viewer for a shared agent status Markdown file."
  }
}
