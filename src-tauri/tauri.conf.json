{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ctx-ppteer",
  "version": "../package.json",
  "identifier": "dev.vivekraman.ctxppteer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ctx-ppteer",
        "width": 360,
        "height": 220,
        "minWidth": 260,
        "minHeight": 120,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/skills": "skills",
      "resources/Credits.rtf": "Credits.rtf"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Always-on-top Markdown status viewer",
    "longDescription": "A lightweight viewer for a shared agent status Markdown file."
  }
}
